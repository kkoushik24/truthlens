# TruthLens Configuration Template
# Copy this file to .env and fill in your values: copy .env.example .env

# LLM Provider: "groq" (recommended, ultra-fast) or "gemini"
LLM_PROVIDER=groq

# Groq API Key (Free, high-speed Llama 3.2 Vision, Llama 3.3 Text & Whisper Large v3)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Alternative multimodal LLM provider)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hugging Face token (optional, for higher rate limits on HF models)
HF_TOKEN=

# Model Swapping Configurations
IMAGE_AI_DETECTOR_MODEL=umm-maybe/AI-image-detector
AUDIO_VOICE_DETECTOR_MODEL=facebook/mms-lid-126
WHISPER_MODEL_SIZE=tiny

# Application Settings & Performance
DEBUG=False
DEFAULT_ELA_QUALITY=90
MAX_VIDEO_FRAMES=12
MAX_IMAGE_PROCESS_DIM=1600
AUTO_DOWNLOAD_HF_MODELS=False
